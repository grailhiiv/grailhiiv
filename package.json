{
  "name": "grailhiiv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:cloud-ui": "playwright test --config playwright.cloud.config.ts",
    "worker:n8n": "node --env-file-if-exists=.env --import tsx scripts/n8n-worker.ts",
    "worker:ai": "node --env-file-if-exists=.env --import tsx scripts/agent-worker.ts",
    "worker:internal": "node --env-file-if-exists=.env --import tsx scripts/internal-worker.ts",
    "worker:social": "node --env-file-if-exists=.env --import tsx scripts/social-worker.ts",
    "backup": "node --env-file=.env --import tsx scripts/backup.ts",
    "backup:verify": "node --env-file=.env --import tsx scripts/backup.ts --verify",
    "setup:ai": "node --env-file-if-exists=.env --import tsx scripts/setup-agent.ts",
    "setup:selfhost": "node scripts/setup-selfhost.mjs",
    "test:supabase": "node --env-file-if-exists=.env --import tsx scripts/verify-supabase.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.12",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint": "1.1.6",
    "@langchain/langgraph-checkpoint-postgres": "1.0.6",
    "@langchain/openai": "1.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
