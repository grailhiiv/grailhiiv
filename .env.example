# Copy to .env. Both npm and Docker Compose use this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for sending invitation emails, never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical origin for email links and CSRF checks.
GRAILHIIV_SITE_URL=http://127.0.0.1:3100
# Local sample mode must be explicitly enabled when Supabase is absent.
GRAILHIIV_DEMO_MODE=true
# Optional n8n bridge for an authenticated workspace. Secrets stay server-side.
GRAILHIIV_N8N_URL=http://127.0.0.1:5678
GRAILHIIV_N8N_WEBHOOK_SECRET=
GRAILHIIV_N8N_CALLBACK_SECRET=
GRAILHIIV_N8N_CALLBACK_URL=http://127.0.0.1:3100
GRAILHIIV_N8N_WORKFLOWS='[{"key":"connection-check","label":"Verify automation connection","path":"grailhiiv-connection-check"}]'
# Docker database and n8n secrets. setup:selfhost fills missing values only.
N8N_POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_EDITOR_BASE_URL=http://127.0.0.1:5678
N8N_SECURE_COOKIE=false
# Optional administrator login record; these are not passed to containers.
N8N_ADMIN_EMAIL=
N8N_ADMIN_PASSWORD=
# Optional AI worker. Server-only credentials; no NEXT_PUBLIC provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Administrator catalog. Use exact model IDs supported by your provider account.
GRAILHIIV_AI_MODELS='[]'
# PostgreSQL direct/session connection for private LangGraph checkpoints (not transaction pooling).
GRAILHIIV_AI_DATABASE_URL=
# Docker supplies the private AI database URL from this URL-safe password.
AI_POSTGRES_PASSWORD=
# Local encrypted backups. Keep this key separately when exporting archives.
GRAILHIIV_BACKUP_KEY=
GRAILHIIV_BACKUP_DIRECTORY=backups
GRAILHIIV_BACKUP_KEEP=7
# Facebook Pages and linked professional Instagram accounts (server-only).
GRAILHIIV_META_APP_ID=
GRAILHIIV_META_APP_SECRET=
GRAILHIIV_META_API_VERSION=v25.0
# Generated by setup:selfhost. Retain this key to decrypt connected account tokens.
GRAILHIIV_SOCIAL_ENCRYPTION_KEY=
